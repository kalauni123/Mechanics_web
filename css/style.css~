@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
    --primary: #4338ca; --primary-hover: #3730a3; --primary-light: #e0e7ff;
    --bg: #f3f4f6; --card: #ffffff;
    --text-main: #1f2937; --text-muted: #6b7280;
    --border: #e5e7eb;
    --success: #059669; --success-bg: #d1fae5; --success-border: #34d399;
    --danger: #dc2626; --danger-bg: #fee2e2; --danger-border: #f87171;
    --warning: #d97706; --warning-bg: #fef3c7;
    --shadow-sm: 0 1px 2px 0 rgba(0,0,0,0.05);
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
    --shadow-lg: 0 10px 25px -3px rgba(0,0,0,0.08), 0 4px 6px -2px rgba(0,0,0,0.04);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body { 
    font-family: 'Inter', system-ui, sans-serif; 
    background-color: var(--bg); 
    background-image: radial-gradient(circle at top right, #e0e7ff 0%, transparent 40%);
    color: var(--text-main); 
    line-height: 1.5; 
    font-size: 15px; 
    -webkit-font-smoothing: antialiased;
}

.header { background: rgba(255,255,255,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); padding: 1.25rem 1rem; position: sticky; top: 0; z-index: 100; box-shadow: var(--shadow-sm); }
.header-inner { max-width: 900px; margin: 0 auto; font-size: 1.3rem; font-weight: 800; color: var(--primary); letter-spacing: -0.02em; text-align: center; }
.container { max-width: 900px; margin: 3rem auto; padding: 0 1rem; }
.card { background: var(--card); padding: 2.5rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.5); box-shadow: var(--shadow-lg); }
.hidden { display: none !important; }
h1, h2 { color: var(--text-main); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1.25rem; }

.subject-label { font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; }
.subject-title { font-size: 1.25rem; font-weight: 800; color: var(--primary); }

.btn { padding: 0.75rem 1.5rem; border: 2px solid var(--border); background: var(--card); color: var(--text-main); border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 1rem; transition: all 0.2s ease; box-shadow: var(--shadow-sm); }
.btn:hover:not(:disabled) { border-color: var(--primary-light); transform: translateY(-2px); box-shadow: var(--shadow-md); }
.btn:active:not(:disabled) { transform: translateY(0); }
.btn-primary { background: var(--primary); color: white; border: none; box-shadow: 0 4px 14px 0 rgba(67, 56, 202, 0.39); }
.btn-primary:hover:not(:disabled) { background: var(--primary-hover); box-shadow: 0 6px 20px rgba(67, 56, 202, 0.23); }
.btn-danger { background: var(--danger); color: white; border: none; }
.btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

.input-full { width: 100%; padding: 0.85rem; border: 2px solid var(--border); border-radius: 10px; font-size: 1rem; font-weight: 500; margin-top: 0.5rem; color: var(--text-main); background-color: #f9fafb; }
.input-full:focus { outline: none; border-color: var(--primary); background-color: var(--card); }
.form-grid { display: grid; gap: 1.25rem; margin-top: 1rem; margin-bottom: 2rem; }

.exam-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; font-weight: 700; font-size: 1.05rem; padding-bottom: 1rem; border-bottom: 2px solid var(--border); }
.timer-text { color: var(--danger); background: var(--danger-bg); padding: 0.35rem 0.85rem; border-radius: 20px; font-variant-numeric: tabular-nums; }
#questionCounter { background: var(--primary-light); color: var(--primary); padding: 0.35rem 0.85rem; border-radius: 20px; }

/* COMPACT FONTS FOR QUESTIONS */
.question-text { font-size: 1.1rem; font-weight: 600; margin-bottom: 1.5rem; color: var(--text-main); overflow-wrap: break-word; }
.options-grid { display: grid; gap: 0.75rem; }
.option { display: flex; align-items: center; gap: 1rem; padding: 0.85rem; border: 2px solid var(--border); border-radius: 12px; cursor: pointer; transition: all 0.2s ease; background: var(--card); font-size: 0.95rem; font-weight: 500; }
.option:hover { border-color: var(--primary); background: #f8fafc; transform: translateX(4px); }
.option.selected { border-color: var(--primary); background: var(--primary-light); }
.option.correct { border-color: var(--success-border); background: var(--success-bg); color: #065f46; }
.option.wrong { border-color: var(--danger-border); background: var(--danger-bg); color: #991b1b; }

.option-label { font-weight: 700; background: var(--border); min-width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 6px; color: var(--text-main); font-size: 0.9rem; }
.option.selected .option-label { background: var(--primary); color: white; }
.option.correct .option-label { background: var(--success); color: white; }
.option.wrong .option-label { background: var(--danger); color: white; }

.nav-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-top: 2rem; }
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-bottom: 2rem; text-align: center; }
.stat-box { padding: 1.25rem; background: #f9fafb; border-radius: 14px; border: 1px solid var(--border); font-weight: 600; color: var(--text-muted); text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em; }
.stat-box strong { font-size: 2.25rem; display: block; margin-top: 0.5rem; letter-spacing: -0.02em; }
.text-primary { color: var(--primary); }
.text-success { color: var(--success); }
.error-text { color: var(--danger); margin-top: 1rem; font-weight: bold; text-align: center; }

/* COMPACT REVIEW SECTION */
.review-item { margin-top: 1.5rem; padding: 1.25rem; border: 2px solid var(--border); border-radius: 14px; background: var(--card); box-shadow: var(--shadow-sm); }
.review-item p { font-size: 1rem; font-weight: 600; margin-bottom: 1rem; }
.explanation-box { margin-top: 1.25rem; padding: 1rem; background: var(--warning-bg); border-left: 5px solid var(--warning); border-radius: 0 10px 10px 0; font-size: 0.9rem; color: #92400e; overflow-wrap: break-word; }

.MathJax { font-size: 1em !important; }
mjx-container[display="true"] { overflow-x: auto; overflow-y: hidden; max-width: 100%; padding-bottom: 0.5rem; }

/* 📱 MOBILE: EDGE-TO-EDGE, NO MARGINS */
@media (max-width: 768px) {
    body { background-color: var(--card); background-image: none; }
    .header { padding: 0.5rem; border-bottom: 1px solid var(--border); box-shadow: none; }
    .header-inner { font-size: 1.1rem; }
    
    .container { margin: 0; padding: 0; max-width: 100%; width: 100%; }
    .card { padding: 1rem 0.5rem; border-radius: 0; border: none; box-shadow: none; }
    .exam-header { margin-bottom: 1rem; padding-bottom: 0.5rem; font-size: 0.95rem; }
    
    .question-text { font-size: 1rem; margin-bottom: 1rem; padding: 0 0.25rem; }
    .options-grid { gap: 0.5rem; }
    .option { padding: 0.75rem 0.5rem; gap: 0.5rem; font-size: 0.9rem; border-radius: 8px; }
    .option-label { min-width: 26px; height: 26px; font-size: 0.8rem; border-radius: 6px; }
    
    .nav-grid { gap: 0.5rem; margin-top: 1.5rem; padding: 0 0.25rem; }
    .btn { padding: 0.75rem 0.5rem; font-size: 0.95rem; border-radius: 8px; }
    
    .stats-grid { grid-template-columns: 1fr; gap: 0.5rem; margin-bottom: 1.5rem; }
    .stat-box { padding: 0.75rem; border-radius: 8px; font-size: 0.8rem; }
    .stat-box strong { font-size: 1.75rem; }
    
    .review-item { margin-top: 1rem; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border); box-shadow: none; }
    .review-item p { font-size: 0.95rem; margin-bottom: 0.5rem; }
    .review-item .option { font-size: 0.85rem; padding: 0.5rem; gap: 0.5rem; }
    .explanation-box { margin-top: 0.75rem; padding: 0.75rem; font-size: 0.85rem; border-radius: 0 8px 8px 0; border-left-width: 4px; }
    
    .MathJax { font-size: 0.95em !important; }
    .review-item .MathJax { font-size: 0.9em !important; }
}
