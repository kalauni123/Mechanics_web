<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advanced Physics MCQ Portal</title>
    
    <link rel="stylesheet" href="css/style.css">
    
    <script>
        window.MathJax = {
            tex: { inlineMath: [['\\(', '\\)']], displayMath: [['\\[', '\\]']], packages: {'[+]': ['physics']} },
            startup: { typeset: false } 
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
</head>
<body>
    <header class="header">
        <div class="header-inner">⚛️ Scalable Physics Examination Portal</div>
    </header>

    <main class="container">
        <!-- Setup Screen -->
        <section id="setupScreen" class="card">
            <h1>Configure Examination</h1>
            <div class="form-grid">
                <!-- Static Active Subject Label -->
                <div style="margin-bottom: 0.5rem;">
                    <span class="subject-label">Active Subject</span>
                    <div class="subject-title">Classical Mechanics</div>
                </div>
                
                <!-- Examination Scope -->
                <div>
                    <label style="font-weight: 600; color: var(--text-main);">Examination Scope</label>
                    <select id="chapterSelect" class="input-full"></select>
                </div>
            </div>
            <!-- Updated Button Text -->
            <button id="startBtn" class="btn btn-primary" style="width:100%; margin-top:1rem;">Start 50-Question Exam</button>
            <p id="errorMsg" class="error-text"></p>
        </section>

        <!-- Active Exam Screen -->
        <section id="examScreen" class="card hidden">
            <div class="exam-header">
                <!-- Updated Counter and Timer defaults -->
                <span id="questionCounter">Q 1 / 50</span>
                <span id="timer" class="timer-text">45:00</span>
            </div>
            
            <div id="questionText" class="question-text"></div>
            <div id="optionsContainer" class="options-grid"></div>

            <div class="nav-grid">
                <button id="prevBtn" class="btn">← Previous</button>
                <button id="nextBtn" class="btn btn-primary">Next →</button>
            </div>
            <button id="submitBtn" class="btn btn-danger" style="width:100%; margin-top:1.5rem;">Submit Examination</button>
        </section>

        <!-- Result Screen -->
        <section id="resultScreen" class="card hidden">
            <h2>Examination Complete</h2>
            <div class="stats-grid">
                <div class="stat-box">Final Score<br><strong id="finalScore" class="text-primary"></strong></div>
                <div class="stat-box">Accuracy<br><strong id="accuracyScore"></strong>%</div>
                <div class="stat-box">Correct<br><strong id="correctCount" class="text-success"></strong></div>
            </div>
            <div id="reviewContainer"></div>
            <button id="homeBtn" class="btn btn-primary" style="width:100%; margin-top:2rem;">Return to Dashboard</button>
        </section>
    </main>

    <!-- LOAD REGISTRY AND DATABASES FIRST -->
    <script src="database/subjectRegistry.js"></script>
    <script src="database/mechanics_ch1.js"></script>
    <script src="database/mechanics_ch2.js"></script>
    <script src="database/mechanics_ch3.js"></script>
    <script src="database/mechanics_ch4.js"></script>
    <script src="database/mechanics_ch5.js"></script>
    <script src="database/mechanics_ch6.js"></script>
    <script src="database/mechanics_ch7.js"></script>
    <script src="database/mechanics_ch8.js"></script>
    <script src="database/mechanics_ch9.js"></script>
    <script src="database/mechanics_ch10.js"></script>
    
    <!-- APPLICATION LOGIC LAST -->
    <script src="js/app.js"></script>
</body>
</html>
